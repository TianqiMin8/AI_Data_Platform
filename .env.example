# .env.example  committed to Git to show required environment variables
ENVIRONMENT=dev
DEBUG=true
APP_NAME=ai-data-platform
APP_VERSION=0.1.0

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_data_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# .env.example 新增
JWT_SECRET_KEY=your-jwt-secret-change-this
ENCRYPTION_KEY=your-fernet-key-run-generate-script

OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT=30
SQL_MAX_ROWS=100
SQL_TIMEOUT_SECONDS=15

# .env.example  committed to Git to show required environment variables
ENVIRONMENT=dev
DEBUG=true
APP_NAME=ai-data-platform
APP_VERSION=0.1.0

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_data_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json
